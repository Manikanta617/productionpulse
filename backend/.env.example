# ProductionPulse Backend Environment Variables
# Copy this file to .env and provide your credentials.
# DO NOT commit .env containing real secrets to Git.

# Google Cloud / Vertex AI (Gemini 2.5 Pro)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ClickHouse Cloud (OLAP Analytics Engine & MergeTree Storage)
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=default

# Parallel AI Search API (Optional live studio research grounding)
PARALLEL_API_KEY=your-parallel-api-key

# Google Cloud Storage
GCS_BUCKET=your-gcs-bucket-name

# Application Configuration
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,https://productionpulse-hackathon.web.app
